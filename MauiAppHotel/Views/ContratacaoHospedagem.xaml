<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppHotel.Views.ContratacaoHospedagem"
    Title="Hotel Premium"
    BackgroundColor="#F0F4FA">

    <ScrollView>
        <VerticalStackLayout
            Padding="18,22,18,30"
            Spacing="18">

            <!-- CABEÇALHO -->
            <VerticalStackLayout
                Spacing="2"
                HorizontalOptions="Center">

                <Label
                    Text="HOTEL PREMIUM"
                    FontFamily="KalamBold"
                    FontSize="34"
                    TextColor="#183153"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Sua estadia começa aqui"
                    FontSize="14"
                    TextColor="#64748B"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

            <!-- FORMULÁRIO -->
            <Border
                BackgroundColor="White"
                Stroke="#DEE7F2"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="18">

                <VerticalStackLayout Spacing="17">

                    <Label
                        Text="Reserve sua hospedagem"
                        FontFamily="KalamBold"
                        FontSize="24"
                        TextColor="#183153" />

                    <BoxView
                        HeightRequest="1"
                        Color="#E2E8F0" />

                    <!-- HÓSPEDES -->
                    <Label
                        Text="HÓSPEDES"
                        FontSize="12"
                        FontAttributes="Bold"
                        CharacterSpacing="1.5"
                        TextColor="#64748B" />

                    <Grid
                        ColumnDefinitions="*,Auto,Auto"
                        RowDefinitions="Auto,Auto"
                        ColumnSpacing="10"
                        RowSpacing="12">

                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="Adultos"
                            FontSize="15"
                            TextColor="#334155"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="{Binding Value}"
                            BindingContext="{x:Reference stp_adultos}"
                            FontAttributes="Bold"
                            TextColor="#2563EB"
                            VerticalOptions="Center" />

                        <Stepper
                            x:Name="stp_adultos"
                            Grid.Row="0"
                            Grid.Column="2"
                            Minimum="0"
                            Maximum="10"
                            Increment="1"
                            Value="1" />

                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            Text="Crianças"
                            FontSize="15"
                            TextColor="#334155"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="{Binding Value}"
                            BindingContext="{x:Reference stp_criancas}"
                            FontAttributes="Bold"
                            TextColor="#2563EB"
                            VerticalOptions="Center" />

                        <Stepper
                            x:Name="stp_criancas"
                            Grid.Row="1"
                            Grid.Column="2"
                            Minimum="0"
                            Maximum="10"
                            Increment="1" />

                    </Grid>

                    <BoxView
                        HeightRequest="1"
                        Color="#E2E8F0" />

                    <!-- ACOMODAÇÃO -->
                    <Label
                        Text="ACOMODAÇÃO"
                        FontSize="12"
                        FontAttributes="Bold"
                        CharacterSpacing="1.5"
                        TextColor="#64748B" />

                    <Label
                        Text="Escolha sua suíte"
                        FontSize="15"
                        TextColor="#334155" />

                    <Border
                        BackgroundColor="#F8FAFD"
                        Stroke="#DCE5F0"
                        StrokeShape="RoundRectangle 12"
                        Padding="10,2">

                        <Picker
                            x:Name="pck_quarto"
                            Title="Selecione sua acomodação"
                            ItemDisplayBinding="{Binding Descricao}"
                            TextColor="#183153"
                            TitleColor="#64748B" />

                    </Border>

                    <BoxView
                        HeightRequest="1"
                        Color="#E2E8F0" />

                    <!-- DATAS -->
                    <Label
                        Text="PERÍODO DA ESTADIA"
                        FontSize="12"
                        FontAttributes="Bold"
                        CharacterSpacing="1.5"
                        TextColor="#64748B" />

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">

                        <Border
                            Grid.Column="0"
                            BackgroundColor="#F8FAFD"
                            Stroke="#DCE5F0"
                            StrokeShape="RoundRectangle 12"
                            Padding="10">

                            <VerticalStackLayout Spacing="6">

                                <Label
                                    Text="Check-in"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="#334155" />

                                <DatePicker
                                    x:Name="dtpck_checkin"
                                    Format="dd/MM/yyyy"
                                    FontSize="13"
                                    TextColor="#183153"
                                    DateSelected="dtpck_checkin_DateSelected" />

                            </VerticalStackLayout>
                        </Border>

                        <Border
                            Grid.Column="1"
                            BackgroundColor="#F8FAFD"
                            Stroke="#DCE5F0"
                            StrokeShape="RoundRectangle 12"
                            Padding="10">

                            <VerticalStackLayout Spacing="6">

                                <Label
                                    Text="Check-out"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="#334155" />

                                <DatePicker
                                    x:Name="dtpck_checkout"
                                    Format="dd/MM/yyyy"
                                    FontSize="13"
                                    TextColor="#183153" />

                            </VerticalStackLayout>
                        </Border>

                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- BOTÕES -->
            <Button
                Text="AVANÇAR"
                FontSize="15"
                FontAttributes="Bold"
                BackgroundColor="#2563EB"
                TextColor="White"
                CornerRadius="13"
                HeightRequest="54"
                Clicked="Avancar_Clicked" />

            <Button
                Text="SOBRE O APLICATIVO"
                FontSize="13"
                FontAttributes="Bold"
                BackgroundColor="#183153"
                TextColor="White"
                CornerRadius="13"
                HeightRequest="50"
                Clicked="Sobre_Clicked" />

            <Label
                Text="HOTEL PREMIUM  •  2026"
                FontSize="11"
                TextColor="#94A3B8"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
