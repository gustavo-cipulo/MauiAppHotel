<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppHotel.Views.Sobre"
    Title="Sobre"
    BackgroundColor="#F0F4FA">

    <ScrollView>
        <VerticalStackLayout
            Padding="20,30"
            Spacing="20">

            <!-- CABEÇALHO -->
            <VerticalStackLayout
                Spacing="5"
                HorizontalOptions="Center">

                <Label
                    Text="HOTEL PREMIUM"
                    FontFamily="KalamBold"
                    FontSize="34"
                    TextColor="#183153"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Sobre o aplicativo"
                    FontSize="15"
                    TextColor="#64748B"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

            <!-- INFORMAÇÕES -->
            <Border
                BackgroundColor="White"
                Stroke="#DEE7F2"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="22">

                <VerticalStackLayout Spacing="16">

                    <Label
                        Text="Conheça o projeto"
                        FontFamily="KalamBold"
                        FontSize="25"
                        TextColor="#183153" />

                    <Label
                        Text="Sistema de contratação de hospedagens desenvolvido com C# e .NET MAUI."
                        FontSize="14"
                        TextColor="#64748B"
                        LineBreakMode="WordWrap" />

                    <BoxView
                        HeightRequest="1"
                        Color="#E2E8F0" />

                    <Label
                        Text="DESENVOLVEDOR"
                        FontSize="12"
                        FontAttributes="Bold"
                        CharacterSpacing="1"
                        TextColor="#2563EB" />

                    <Label
                        Text="Gustavo Cipulo Almeida Batista da Silva"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="#183153" />

                    <Label
                        Text="ANO DE DESENVOLVIMENTO"
                        FontSize="12"
                        FontAttributes="Bold"
                        CharacterSpacing="1"
                        TextColor="#2563EB" />

                    <Label
                        Text="2026"
                        FontSize="16"
                        TextColor="#334155" />

                    <Label
                        Text="TECNOLOGIAS"
                        FontSize="12"
                        FontAttributes="Bold"
                        CharacterSpacing="1"
                        TextColor="#2563EB" />

                    <Label
                        Text="C#  •  XAML  •  .NET MAUI"
                        FontSize="15"
                        TextColor="#334155" />

                    <BoxView
                        HeightRequest="1"
                        Color="#E2E8F0" />

                    <Label
                        Text="FUNCIONALIDADES"
                        FontSize="12"
                        FontAttributes="Bold"
                        CharacterSpacing="1"
                        TextColor="#2563EB" />

                    <Label
                        Text="Seleção de hóspedes, escolha de suítes, definição das datas de estadia e validação das informações."
                        FontSize="14"
                        TextColor="#475569"
                        LineBreakMode="WordWrap" />

                    <Label
                        Text="Programação Mobile I — Agenda 14"
                        FontSize="13"
                        TextColor="#64748B" />

                </VerticalStackLayout>
            </Border>

            <!-- VOLTAR -->
            <Button
                Text="VOLTAR"
                BackgroundColor="#183153"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="13"
                HeightRequest="52"
                Clicked="Voltar_Clicked" />

            <Label
                Text="Desenvolvido em 2026"
                FontSize="11"
                TextColor="#94A3B8"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
